# ========================================================
# SHARLOKINSTA - TEMPLATE DE CONFIGURAÇÃO DE AMBIENTE
# ========================================================
# Copie este arquivo para .env e preencha com seus dados:
# cp .env.example .env

# Nome de usuário da sua conta do Instagram no navegador
IG_USER=seu_usuario_aqui

# ID numérico da conta (ds_user_id obtido nos cookies)
IG_DS_USER_ID=seu_ds_user_id_aqui

# Cookie sessionid copiado do navegador Chrome Desktop
IG_SESSIONID=seu_sessionid_aqui
